# Supabase — copy to `.env.local` and fill in your project values
# URL must be the project root only (no /rest/v1/ suffix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role — server-only (Lemon Squeezy webhooks). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL used for checkout redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Lemon Squeezy (no monthly platform fee — pay only on successful sales)
# Create a $15/mo subscription product, then fill:
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Optional fallback if you prefer a static buy link instead of the API:
# NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/xxxx
